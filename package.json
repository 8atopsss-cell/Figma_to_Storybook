  "private": true,
  "type": "module",
  "scripts": {
    "figma:sync-registry": "node scripts/generate-figma-sync-registry.mjs",
    "tokens": "node scripts/generate-tokens.mjs && node scripts/generate-style-tokens.mjs && node scripts/generate-checkbox-tokens.mjs && node scripts/generate-toggle-tokens.mjs && node scripts/generate-icon-button-tokens.mjs && node scripts/generate-resource-tag-tokens.mjs && node scripts/generate-badge-tokens.mjs && node scripts/generate-table-row-tokens.mjs && node scripts/generate-menu-button-tokens.mjs && node scripts/generate-sidebar-tokens.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "npm run tokens && tsc --noEmit && vite build",
    "storybook": "storybook dev -p 6007 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "npm run tokens && storybook build --disable-telemetry",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
